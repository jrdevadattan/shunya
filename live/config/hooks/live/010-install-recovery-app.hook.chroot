#!/bin/sh
set -eu
if ls /opt/recovery/staging/*.deb >/dev/null 2>&1; then
  dpkg -i /opt/recovery/staging/*.deb || apt-get -f install -y
fi
test -f /opt/recovery/staging/recovery-privileged-helper
install -d -m 0755 /usr/local/libexec
install -m 0755 /opt/recovery/staging/recovery-privileged-helper /usr/local/libexec/recovery-privileged-helper
APP=$(command -v sih-recovery-platform)
sha256sum "$APP" /usr/local/libexec/recovery-privileged-helper > /opt/recovery/release-manifest.sha256
